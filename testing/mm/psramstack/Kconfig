#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_PSRAM_STACK
	tristate "PSRAM stack test"
	default n
	---help---
		Enable a stack placement and context-switch diagnostic for boards
		with PSRAM in the user heap.

if TESTING_PSRAM_STACK

config TESTING_PSRAM_STACK_PROGNAME
	string "Program name"
	default "psramstack"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TESTING_PSRAM_STACK_PRIORITY
	int "PSRAM stack test task priority"
	default 100

config TESTING_PSRAM_STACK_STACKSIZE
	int "PSRAM stack test stack size"
	default 8192

endif
