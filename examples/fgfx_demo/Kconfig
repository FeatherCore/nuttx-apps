#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_FGFX_DEMO
	tristate "FGFX framebuffer demo"
	default n
	depends on GRAPHICS_FGFX
	depends on VIDEO_FB
	---help---
		Build a small FGFX framebuffer demo.  It opens a framebuffer device,
		renders animated FGFX display-list content into an RGBA surface, and
		copies the result into the framebuffer.

if EXAMPLES_FGFX_DEMO

config EXAMPLES_FGFX_DEMO_PROGNAME
	string "Program name"
	default "fgfxdemo"

config EXAMPLES_FGFX_DEMO_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_FGFX_DEMO_STACKSIZE
	int "Stack size"
	default 32768

config EXAMPLES_FGFX_DEMO_FBDEV
	string "Framebuffer device"
	default "/dev/fb0"

config EXAMPLES_FGFX_DEMO_FRAMES
	int "Frame count"
	default 0
	---help---
		Number of animation frames to render.  Zero means run until the
		simulator is stopped.

config EXAMPLES_FGFX_DEMO_FRAME_DELAY_US
	int "Frame delay in microseconds"
	default 33000

endif
