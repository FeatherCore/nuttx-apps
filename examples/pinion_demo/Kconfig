#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_PINION_DEMO
	tristate "Pinion framebuffer game demo"
	default n
	depends on GRAPHICS_PINION
	depends on VIDEO_FB
	---help---
		Build a small Pinion demo.  It opens a framebuffer device,
		renders animated Pinion surface content, and copies the result into
		the framebuffer.

if EXAMPLES_PINION_DEMO

config EXAMPLES_PINION_DEMO_PROGNAME
	string "Program name"
	default "piniondemo"

config EXAMPLES_PINION_DEMO_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_PINION_DEMO_STACKSIZE
	int "Stack size"
	default 16384

config EXAMPLES_PINION_DEMO_FBDEV
	string "Framebuffer device"
	default "/dev/fb0"

config EXAMPLES_PINION_DEMO_FRAMES
	int "Frame count"
	default 0
	---help---
		Number of animation frames to render.  Zero means run until the
		simulator is stopped.

config EXAMPLES_PINION_DEMO_FRAME_DELAY_US
	int "Frame delay in microseconds"
	default 33000

endif # EXAMPLES_PINION_DEMO
