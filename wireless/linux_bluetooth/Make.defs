ifneq ($(CONFIG_LINUX_BTCTL),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
else ifneq ($(CONFIG_LINUX_BTBNEPTEST),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
else ifneq ($(CONFIG_LINUX_BLUEZ_BNEPTEST),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
else ifneq ($(CONFIG_LINUX_BLUEZ_NETWORK),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
else ifneq ($(CONFIG_LINUX_BLUEZ_MGMT),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
else ifneq ($(CONFIG_LINUX_BLUEZ_BTMON),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
else ifneq ($(CONFIG_LINUX_BLUEZ_HCIIOCTL),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
else ifneq ($(CONFIG_LINUX_BLUEZ_HCIRAW),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
else ifneq ($(CONFIG_LINUX_BTAUDIO),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
else ifneq ($(CONFIG_LINUX_BTVHCID),)
CONFIGURED_APPS += $(APPDIR)/wireless/linux_bluetooth
endif
