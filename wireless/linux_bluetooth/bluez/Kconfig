	default DEFAULT_TASK_STACKSIZE

endif

config LINUX_BLUEZ_HFP
	tristate "BlueZ HFP/HSP Profile-shaped adapter"
	default y
	depends on LINUX_BLUEZ_PORT
	---help---
		Enable bluezhfp, a BlueZ-facing Hands-Free/Headset adapter.
		It provides an independent apps-side closeout surface for
		HFP HF/AG and HSP HS/AG roles, including RFCOMM-shaped AT
		transactions and SCO-like audio bearer evidence, instead of
		relying only on the aggregate bluezdaemon profile marker.

