config LINUX_BLUEZ_OBEX
	tristate "BlueZ OBEX Profile-shaped adapter"
	default y
	depends on LINUX_BLUEZ_PORT
	---help---
		Enable bluezobex, a BlueZ obexd-facing adapter for PBAP, OPP,
		MAP, MNS, FTP, Sync, and BIP closeout.  It drives OBEX
		transactions over an RFCOMM-shaped Linux Bluetooth L2CAP bearer
		so the hwsim cases no longer rely only on aggregate bluezdaemon
		profile markers for OBEX coverage.

if LINUX_BLUEZ_OBEX

