config LINUX_BLUEZ_MGMT
	tristate "BlueZ mgmt control client"
	default y
	depends on LINUX_BLUEZ_PORT
	---help---
		Enable bluezmgmt, a BlueZ-style mgmt control client that uses
		AF_BLUETOOTH/BTPROTO_HCI with HCI_CHANNEL_CONTROL to drive the
		NuttX Linux Bluetooth port through the same socket ABI expected
		by BlueZ user space.

if LINUX_BLUEZ_MGMT

config LINUX_BLUEZ_MGMT_PROGNAME
	string "bluezmgmt program name"
	default "bluezmgmt"

config LINUX_BLUEZ_MGMT_PRIORITY
	int "bluezmgmt task priority"
	default 100

config LINUX_BLUEZ_MGMT_STACKSIZE
	int "bluezmgmt stack size"
	default DEFAULT_TASK_STACKSIZE

endif

config LINUX_BLUEZ_DAEMON
	tristate "BlueZ bluetoothd-shaped mgmt daemon smoke"
	default y
	depends on LINUX_BLUEZ_PORT
	---help---
		Enable bluezdaemon, a daemon-shaped BlueZ adapter that keeps a
		long-lived AF_BLUETOOTH/BTPROTO_HCI mgmt control socket and drives
		the same controller initialization, discovery, pairing, connection
		info, and disconnect sequence that bluetoothd would issue through
		src/main.c and src/adapter.c.  This is an incremental entry point
		toward the full bluetoothd/profile port, not a replacement for the
		complete upstream daemon.

if LINUX_BLUEZ_DAEMON

config LINUX_BLUEZ_DAEMON_PROGNAME
	string "bluezdaemon program name"
	default "bluezdaemon"

config LINUX_BLUEZ_DAEMON_PRIORITY
	int "bluezdaemon task priority"
	default 100

config LINUX_BLUEZ_DAEMON_STACKSIZE
	int "bluezdaemon stack size"
	default DEFAULT_TASK_STACKSIZE

endif

config LINUX_BLUEZ_AUDIO
	tristate "BlueZ audio profile-shaped socket smoke"
	default y
	depends on LINUX_BLUEZ_PORT
	---help---
		Enable bluezaudio, a BlueZ profile-shaped audio adapter that
		drives the Linux Bluetooth L2CAP and ISO socket paths from the
		apps/wireless/linux_bluetooth/bluez subtree.  It is an incremental
		bridge toward the full BlueZ A2DP and LE Audio profile plugins,
		and currently validates synthetic media payload transport over the
		NuttX Linux-BT/VHCI/hwsim path.

if LINUX_BLUEZ_AUDIO

config LINUX_BLUEZ_AUDIO_PROGNAME
	string "bluezaudio program name"
	default "bluezaudio"

config LINUX_BLUEZ_AUDIO_PRIORITY
	int "bluezaudio task priority"
	default 100

config LINUX_BLUEZ_AUDIO_STACKSIZE
	int "bluezaudio stack size"
	default DEFAULT_TASK_STACKSIZE

config LINUX_BLUEZ_AUDIO_LIBSBC
	bool "Use real libsbc backend for BlueZ A2DP SBC"
	default n
	---help---
		Enable this only after an SBC codec implementation has been
		imported into the NuttX apps tree and wired into the
		bluezaudio build.  When disabled, the A2DP hwsim gate must
		report the deterministic SBC-frame backend instead of claiming
		a real libsbc encode/decode path.

endif

