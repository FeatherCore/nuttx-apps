menu "BlueZ userspace port"
	depends on NET_LINUX_BLUETOOTH

config LINUX_BLUEZ_PORT
	bool "Full BlueZ userspace port root"
	default y
	depends on NET_LINUX_BLUETOOTH
	---help---
		Enable the apps-side BlueZ port root.  The complete upstream BlueZ
		source is exposed under apps/wireless/linux_bluetooth/bluez/upstream,
		while NuttX-specific executable adapters and shims live under this
		bluez subtree.

config LINUX_BLUEZ_BNEPTEST
	tristate "BlueZ bneptest compatibility tool"
	default y
	depends on LINUX_BLUEZ_PORT
	---help---
		Enable bluezbneptest, the first apps-side BlueZ tool adapter for
		the Linux Bluetooth port.  It follows the BlueZ tools/bneptest.c
		network-profile shape closely enough to verify the native fd
		handoff boundary: connected L2CAP socket fd passed to BNEPCONNADD,
		then BNEP connlist/conninfo/conndel cleanup.

if LINUX_BLUEZ_BNEPTEST

config LINUX_BLUEZ_BNEPTEST_PROGNAME
	string "bluezbneptest program name"
	default "bluezbneptest"

config LINUX_BLUEZ_BNEPTEST_PRIORITY
	int "bluezbneptest task priority"
	default 100

config LINUX_BLUEZ_BNEPTEST_STACKSIZE
	int "bluezbneptest stack size"
	default DEFAULT_TASK_STACKSIZE

endif

config LINUX_BLUEZ_NETWORK
	tristate "BlueZ Network Profile-shaped adapter"
	default y
	depends on LINUX_BLUEZ_PORT
	---help---
		Enable blueznetwork, a BlueZ profiles/network-shaped adapter.
		It follows the connection.c + bnep.c lifecycle more closely than
		the standalone bneptest tool: profile connect creates a connected
		L2CAP socket, passes that fd to BNEPCONNADD with the BlueZ
		BNEP_SETUP_RESPONSE flag, exposes status, and disconnects through
		BNEPCONNDEL.

if LINUX_BLUEZ_NETWORK

config LINUX_BLUEZ_NETWORK_PROGNAME
	string "blueznetwork program name"
	default "blueznetwork"

config LINUX_BLUEZ_NETWORK_PRIORITY
	int "blueznetwork task priority"
	default 100

config LINUX_BLUEZ_NETWORK_STACKSIZE
	int "blueznetwork stack size"
	default DEFAULT_TASK_STACKSIZE

endif

config LINUX_BLUEZ_IPSP
	tristate "BlueZ LE IPSP Profile-shaped adapter"
	default y
	depends on LINUX_BLUEZ_PORT && NET_LINUX_BLUETOOTH_6LOWPAN_BRIDGE
	---help---
		Enable bluezipsp, a BlueZ-facing LE IPSP profile adapter for
		BLE 6LoWPAN/IP networking validation.  It drives the imported
		Linux Bluetooth 6LoWPAN path through an apps-side BlueZ-shaped
		connect/status/disconnect surface instead of the low-level btctl
		probe command.

if LINUX_BLUEZ_IPSP

config LINUX_BLUEZ_IPSP_PROGNAME
	string "bluezipsp program name"
	default "bluezipsp"

config LINUX_BLUEZ_IPSP_PRIORITY
	int "bluezipsp task priority"
	default 100

config LINUX_BLUEZ_IPSP_STACKSIZE
	int "bluezipsp stack size"
	default DEFAULT_TASK_STACKSIZE

endif

config LINUX_BLUEZ_GATT
	tristate "BlueZ GATT/ATT Profile-shaped adapter"
	default y
	depends on LINUX_BLUEZ_PORT
	---help---
		Enable bluezgatt, a BlueZ-facing GATT/ATT adapter for generic
		BLE attribute profile validation.  This is intentionally
		separate from the LE Audio tool so GATT can converge toward
		shared/att.c, shared/gatt-db.c, shared/gatt-client.c, and
		shared/gatt-server.c semantics as its own profile surface.

if LINUX_BLUEZ_GATT

config LINUX_BLUEZ_GATT_PROGNAME
	string "bluezgatt program name"
	default "bluezgatt"

config LINUX_BLUEZ_GATT_PRIORITY
	int "bluezgatt task priority"
	default 100

config LINUX_BLUEZ_GATT_STACKSIZE
	int "bluezgatt stack size"
	default DEFAULT_TASK_STACKSIZE

endif

config LINUX_BLUEZ_HID
	tristate "BlueZ HID/HOGP Profile-shaped adapter"
	default y
	depends on LINUX_BLUEZ_PORT
	---help---
		Enable bluezhid, a BlueZ-facing HID and HID-over-GATT adapter.
		It provides an independent apps-side closeout surface for
		profiles/input/device.c, server.c, hog.c, hog-lib.c, Linux HIDP,
		and the ATT/GATT report path instead of relying only on the
		aggregate bluezdaemon profile marker.

if LINUX_BLUEZ_HID

config LINUX_BLUEZ_HID_PROGNAME
	string "bluezhid program name"
	default "bluezhid"

