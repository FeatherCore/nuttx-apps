#
# For a description of the syntax of this configuration file,
# see misc/tools/kconfig-language.txt.
#

config BLE_PERIPH_DEMO
	tristate "BLE peripheral validation demo"
	default n
	depends on WIRELESS_BLUETOOTH_HOST && NET_BLUETOOTH
	---help---
		Enable a single NSH command that registers a minimal GATT server and
		starts connectable BLE advertising through the NuttX Bluetooth host.

if BLE_PERIPH_DEMO

config BLE_PERIPH_DEMO_PROGNAME
	string "BLE peripheral demo program name"
	default "ble_periph"

config BLE_PERIPH_DEMO_PRIORITY
	int "BLE peripheral demo task priority"
	default 100

config BLE_PERIPH_DEMO_STACKSIZE
	int "BLE peripheral demo stack size"
	default DEFAULT_TASK_STACKSIZE

config BLE_PERIPH_DEMO_IFNAME
	string "Default Bluetooth network interface"
	default "bnep0"

config BLE_PERIPH_DEMO_NAME
	string "Default BLE advertising name"
	default "Feather-ESP-BLE"

config BLE_PERIPH_DEMO_DEFAULT_VALUE
	string "Default GATT demo characteristic value"
	default "Feather peripheral ready"

endif
