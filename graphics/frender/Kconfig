#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig GRAPHICS_FRENDER
	bool "Feather render backend"
	default n
	---help---
		Enable the Feather application-side render backend.

		FRender owns backend-neutral drawing commands, backend capability
		declarations, software execution, and future adapters to NuttX
		graphics, framebuffer, NX, DMA2D, and GPU2D paths.

if GRAPHICS_FRENDER

config GRAPHICS_FRENDER_SW
	bool "FRender software backend"
	default y
	---help---
		Enable the software backend.  This backend defines first-stage
		rendering correctness and does not require hardware acceleration.

config GRAPHICS_FRENDER_FB_PRESENT
	bool "FRender framebuffer present adapter"
	default y if VIDEO_FB
	depends on VIDEO_FB
	---help---
		Enable the framebuffer present adapter.  This adapter copies a
		FRender RGBA8888 memory surface into a NuttX framebuffer device such
		as /dev/fb0.

endif
